# CueMeet Bot API Configuration

# Debug mode
DEBUG=True

# Required: Deepgram API Key for speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Required: Groq API Key for LLM text generation  
GROQ_API_KEY=your_groq_api_key_here

# ===== VOICE MODE CONFIGURATION =====
# Choose ONE of the following TTS options:

# Option 1: External TTS Microservice (Legacy - for --speak false)
TTS_MICROSERVICE_URL=https://smolservice.onrender.com

# Option 2: Pipecat In-House Voice (New - for --speak true)
# When using --speak true, GROQ_API_KEY and DEEPGRAM_API_KEY are used directly
# No external TTS microservice needed - all in-house
# Build Docker with: docker build --build-arg ENABLE_VOICE=true
# Run with: python app.py <meet_link> --speak true

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./local.db

# Server configuration
HOST=0.0.0.0
PORT=8000

# Optional: Highlight.io monitoring
HIGHLIGHT_PROJECT_ID=
ENVIRONMENT_NAME=